# Copy to packages/db/.env for local development. Never commit the real .env.
# Matches infra/docker-compose.yml's default Postgres credentials.

# Owner/superuser connection — migrations and seeding only. Bypasses RLS, so it must
# never be used for anything that reads or writes tenant data.
DATABASE_URL=postgres://mezbaan:mezbaan_dev_password@localhost:5432/mezbaan

# Restricted application role (created by migrate.ts) — everything else connects as
# this, so RLS actually applies.
APP_DATABASE_URL=postgres://mezbaan_app:mezbaan_app_dev_password@localhost:5432/mezbaan
