# Copy to infra/.env for local development. Never commit the real .env.

POSTGRES_USER=mezbaan
POSTGRES_PASSWORD=mezbaan_dev_password
POSTGRES_DB=mezbaan
POSTGRES_PORT=5432

PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

VALKEY_PORT=6379

# Performance observability (P1-32): slow-query threshold in milliseconds, plus the
# ports for postgres-exporter, Prometheus and the Grafana performance dashboard.
SLOW_QUERY_LOG_MS=200
POSTGRES_EXPORTER_PORT=9187
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=mezbaan_dev_password

# S3-compatible storage (Garage). GARAGE_ADMIN_TOKEN must match infra/garage.toml's
# [admin] admin_token — it's a dev-only secret, safe to keep as the committed default.
GARAGE_S3_PORT=9000
GARAGE_ADMIN_PORT=3903
GARAGE_ADMIN_TOKEN=2925a2d4ba0a341fbce668efb3f61d612899db9c47306cb57472a9233b618cfa
S3_BUCKET=mezbaan-local
S3_KEY_NAME=mezbaan-local-key
# Garage access keys must be in Garage's own format: "GK" + 24 hex chars.
# Free-form names are rejected by the key-import API.
S3_ACCESS_KEY_ID=GKf72f4a98ea11b3a20ece3475
S3_SECRET_ACCESS_KEY=e64b2bc9bd42da7e9d1f585cf1b7364468ef0f30810c08b5b03b05a2cf41a09d
